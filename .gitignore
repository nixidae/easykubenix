# Default-deny at the top level: a new file or directory here stays
# untracked until it is named below.
/*
!/.assets/
!/.envrc
!/.github/
!/.gitignore
!/LICENSE
!/README.md
!/TODO.md
!/checks.nix
!/ci/
!/default.nix
!/demo/
!/design/
!/docs/
!/easykubenix/
!/ekn/
!/eval.nix
!/flake.lock
!/flake.nix
!/mypy.ini
!/nix/
!/pytest.ini
!/ruff-strict.toml
!/ruff.toml
!/shell.nix
!/tests/
!/tools/

result
result-*
/docs/_build
__pycache__/
*.pyc
.pytest_cache/
.pytest-agent/
.venv/
*.egg-info/
dist/
build/

# `ekn tofu` working directories: .terraform/ and, for a local backend, live
# state. Per unit, created beside whatever configuration was evaluated.
.ekn/

# Nix / direnv
.direnv/


# Personal Claude Code settings
.claude/settings.local.json
